# Copy to .env.local for development, and set real values in your hosting
# provider's environment settings for production. Never commit .env.local.

# The production origin, no trailing slash. Used for canonicals, sitemap.xml,
# robots.txt, and all JSON-LD "url" fields.
SITE_URL=https://www.clipgrabdownloader.com

SITE_NAME="ClipGrab Downloader"
SITE_SHORT_NAME=ClipGrab
SITE_DESCRIPTION="Download public videos and Reels from Instagram, TikTok, YouTube, Facebook, X, and Pinterest — just paste a link. Fast, free, and mobile-friendly."

# Absolute or root-relative path to the default Open Graph image (1200x630).
DEFAULT_OG_IMAGE=/images/og/default.png

TWITTER_HANDLE=@clipgrabapp

# From Google Search Console (Settings > Ownership verification > HTML tag),
# just the content value, not the full <meta> tag.
GOOGLE_SITE_VERIFICATION=

CONTACT_EMAIL=aureviaqatar@gmail.com

# Optional. Only relevant if you switch to the yt-dlp alternative extractor
# (see README "How downloading works" -> "Alternative: yt-dlp") and
# `yt-dlp` isn't on the server's PATH — set this to the full binary path.
YTDLP_PATH=

# Optional. Once you have a real Android APK hosted somewhere (or a Play
# Store listing URL), set this and a "Get the app" banner appears on the
# homepage automatically. Leave empty/unset to keep that banner hidden —
# it never shows a dead link.
ANDROID_APP_URL=
